{
  "compileOnSave": true,
  "include": ["./src/**/*", "./capacitor.config.ts", "./capacitor.config.js"],
  "compilerOptions": {
    "outDir": "./build",
    "importHelpers": true,
    "target": "ES2017",
    "module": "Node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "allowJs": true,
    "rootDir": ".",
    "skipLibCheck": true
  }
}
